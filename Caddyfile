# Routes by path, not by container: nginx (cairn-web's image) only ever serves static files, so
# the split between the SPA and the API happens here instead of baking a backend hostname into
# the frontend image. CAIRN_DOMAIN and rp-id/allowed-origins must agree; see AGENTS.md.
{$CAIRN_DOMAIN} {
    encode zstd gzip

    @api path /api/* /login /logout /webauthn/*
    handle @api {
        reverse_proxy api:8080
    }

    handle {
        reverse_proxy web:80
    }
}
