<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="006-create-quotes-table" author="cairn">
        <createTable tableName="quotes">
            <column name="instrument_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_quotes_instrument"
                             references="instruments(id)" deleteCascade="true"/>
            </column>
            <column name="as_of" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="numeric(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="char(3)">
                <constraints nullable="false"/>
            </column>
            <column name="source" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="fetched_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="quotes" columnNames="instrument_id, as_of"
                       constraintName="pk_quotes"/>
        <createIndex tableName="quotes" indexName="ix_quotes_as_of">
            <column name="as_of"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
